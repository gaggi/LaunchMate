#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "launchmate.ico"

IDD_PROGRAM_OPTIONS DIALOGEX 0, 0, 230, 122
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Program options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Arguments", -1, 10, 10, 70, 10
    EDITTEXT IDC_PROGRAM_ARGS, 10, 22, 210, 14, ES_AUTOHSCROLL
    LTEXT "Start delay (ms)", -1, 10, 44, 95, 10
    EDITTEXT IDC_PROGRAM_DELAY, 10, 56, 100, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Stop delay (ms)", -1, 120, 44, 95, 10
    EDITTEXT IDC_PROGRAM_CLOSE_DELAY, 120, 56, 100, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON "OK", IDC_PROGRAM_OK, 134, 100, 40, 14
    PUSHBUTTON "Cancel", IDC_PROGRAM_CANCEL, 178, 100, 42, 14
END

IDD_MONITOR_POWER_SETUPS DIALOGEX 0, 0, 520, 250
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Monitor configs"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Setups", -1, 10, 10, 80, 10
    LISTBOX IDC_MONITOR_SETUP_LIST, 10, 22, 126, 180, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON "+", IDC_MONITOR_SETUP_ADD, 10, 210, 28, 14
    PUSHBUTTON "-", IDC_MONITOR_SETUP_REMOVE, 42, 210, 28, 14
    LTEXT "Name", -1, 150, 10, 80, 10
    EDITTEXT IDC_MONITOR_SETUP_NAME, 150, 22, 175, 14, ES_AUTOHSCROLL
    LTEXT "Hotkey", -1, 335, 10, 80, 10
    CONTROL "", IDC_MONITOR_SETUP_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 335, 22, 175, 14
    PUSHBUTTON "Detect Current", IDC_MONITOR_SETUP_CAPTURE, 150, 210, 62, 14
    PUSHBUTTON "Apply", IDC_MONITOR_SETUP_APPLY, 382, 210, 36, 14
    DEFPUSHBUTTON "Save", IDC_MONITOR_SETUP_SAVE, 422, 210, 36, 14
    PUSHBUTTON "Close", IDC_MONITOR_SETUP_CLOSE, 462, 210, 40, 14
END

IDD_RULE_ACTIONS DIALOGEX 0, 0, 420, 250
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rule actions"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ACTION_TAB, "SysTabControl32", WS_TABSTOP, 10, 10, 400, 20
    LISTBOX IDC_ACTION_LIST, 10, 36, 400, 166, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON "Add", IDC_ACTION_ADD, 10, 212, 48, 16
    PUSHBUTTON "Edit", IDC_ACTION_EDIT, 62, 212, 48, 16
    PUSHBUTTON "Remove", IDC_ACTION_REMOVE, 114, 212, 54, 16
    LTEXT "Monitor config to activate", IDC_ACTION_MONITOR_LABEL, 18, 52, 140, 10
    COMBOBOX IDC_ACTION_MONITOR_COMBO, 18, 68, 384, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Restore previous display configuration when watched process exits", IDC_ACTION_MONITOR_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 18, 96, 320, 12
    DEFPUSHBUTTON "OK", IDOK, 310, 226, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 362, 226, 48, 16
END

IDD_START_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start program"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PATH, 72, 32, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 32, 34, 14
    LTEXT "Arguments", -1, 10, 58, 55, 10
    EDITTEXT IDC_ACTION_ARGUMENTS, 72, 56, 278, 14, ES_AUTOHSCROLL
    LTEXT "Start delay (ms)", -1, 10, 82, 82, 10
    EDITTEXT IDC_ACTION_DELAY, 96, 80, 70, 14, ES_NUMBER
    CONTROL "Close when watched process exits", IDC_ACTION_CLOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 108, 190, 12
    LTEXT "Stop delay (ms)", -1, 202, 108, 78, 10
    EDITTEXT IDC_ACTION_CLOSE_DELAY, 282, 106, 68, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END

IDD_STOP_ACTION DIALOGEX 0, 0, 360, 188
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Stop process"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Process", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PROCESS, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program path", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PATH, 72, 56, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 56, 34, 14
    CONTROL "Try graceful close first", IDC_ACTION_GRACEFUL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 84, 150, 12
    LTEXT "Force after (ms)", -1, 180, 84, 82, 10
    EDITTEXT IDC_ACTION_FORCE_DELAY, 270, 82, 80, 14, ES_NUMBER
    CONTROL "Restart when watched process exits", IDC_ACTION_RESTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 110, 198, 12
    LTEXT "Restart delay (ms)", -1, 206, 110, 82, 10
    EDITTEXT IDC_ACTION_RESTART_DELAY, 290, 108, 60, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 162, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 162, 48, 16
END

IDD_HOME_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Home Assistant webhook"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Webhook URL", -1, 10, 34, 58, 10
    EDITTEXT IDC_ACTION_URL, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "JSON payload", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PAYLOAD, 72, 56, 278, 62, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Delay (ms)", -1, 10, 130, 58, 10
    EDITTEXT IDC_ACTION_DELAY, 72, 128, 80, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END
