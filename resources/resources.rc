#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "launchmate.ico"

IDD_RULE_SECTION DIALOGEX 0, 0, 380, 260
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Add...", IDC_ACTION_ADD, 0, 0, 56, 16
    PUSHBUTTON "Edit...", IDC_ACTION_EDIT, 60, 0, 56, 16
    PUSHBUTTON "Remove", IDC_ACTION_REMOVE, 120, 0, 56, 16
    CONTROL "", IDC_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 22, 380, 238
    GROUPBOX "When the watched process starts", IDC_ACTION_MONITOR_APPLY_GROUP, 0, 0, 380, 92
    LTEXT "Monitor configuration", IDC_ACTION_MONITOR_LABEL, 10, 14, 140, 10
    COMBOBOX IDC_ACTION_MONITOR_COMBO, 10, 26, 360, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Apply delay (ms)", IDC_ACTION_MONITOR_DELAY_LABEL, 10, 48, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_DELAY, 116, 46, 70, 14, ES_NUMBER
    LTEXT "Use a saved monitor configuration while this watched process runs.", IDC_ACTION_MONITOR_APPLY_HINT, 10, 70, 360, 10
    GROUPBOX "When the watched process exits", IDC_ACTION_MONITOR_RESTORE_GROUP, 0, 100, 380, 82
    CONTROL "Restore the previous display configuration", IDC_ACTION_MONITOR_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 114, 360, 14
    LTEXT "Restore delay (ms)", IDC_ACTION_MONITOR_RESTORE_DELAY_LABEL, 10, 136, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_RESTORE_DELAY, 116, 134, 70, 14, ES_NUMBER
    LTEXT "Return to the monitor arrangement that was active before the rule started.", IDC_ACTION_MONITOR_RESTORE_HINT, 10, 160, 360, 10
END

IDD_IRACING_PERFORMANCE_PANE DIALOGEX 0, 0, 380, 344
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Power plan while this watched process runs", -1, 0, 0, 290, 10
    COMBOBOX IDC_IRACING_PLAN, 0, 12, 296, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_IRACING_REFRESH, 302, 11, 70, 16
    LTEXT "Process priorities while this watched process runs", -1, 0, 38, 300, 10
    CONTROL "", IDC_PERF_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 50, 380, 90
    PUSHBUTTON "Add running process", IDC_PERF_ACTION_ADD, 0, 146, 102, 16
    PUSHBUTTON "Edit", IDC_PERF_ACTION_EDIT, 108, 146, 48, 16
    PUSHBUTTON "Remove", IDC_PERF_ACTION_REMOVE, 162, 146, 58, 16
    LTEXT "System check", -1, 0, 172, 200, 10
    EDITTEXT IDC_IRACING_STATUS, 0, 184, 380, 62, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    GROUPBOX "Specific settings", IDC_IRACING_INI_GROUP, 0, 254, 380, 90
    CONTROL "carPreloadAll", IDC_IRACING_CAR_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 270, 180, 14
    PUSHBUTTON "Add Defender exclusions...", IDC_IRACING_DEFENDER, 214, 269, 156, 16
    CONTROL "trackTexturePreload", IDC_IRACING_TRACK_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 288, 180, 14
    LTEXT "streamingTextureSize", IDC_IRACING_STREAMING_LABEL, 10, 310, 100, 10
    EDITTEXT IDC_IRACING_STREAMING_SIZE, 116, 308, 60, 14, ES_NUMBER
    PUSHBUTTON "Save to app.ini", IDC_IRACING_INI, 10, 326, 90, 14
    LTEXT "Close iRacing before saving. A backup is created.", IDC_IRACING_INI_HINT, 106, 328, 264, 10
END

IDD_PROCESS_PERFORMANCE_ACTION DIALOGEX 0, 0, 500, 245
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Process performance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Running process", -1, 10, 12, 84, 10
    COMBOBOX IDC_PERF_PROCESS, 102, 10, 385, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU priority", -1, 10, 40, 84, 10
    COMBOBOX IDC_PERF_CPU_PRIORITY, 102, 38, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "I/O priority", -1, 280, 40, 70, 10
    COMBOBOX IDC_PERF_IO_PRIORITY, 354, 38, 133, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Memory priority", -1, 10, 68, 84, 10
    COMBOBOX IDC_PERF_MEMORY_PRIORITY, 102, 66, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU affinity (select the logical CPUs this process may use)", -1, 10, 100, 400, 10
    DEFPUSHBUTTON "OK", IDOK, 386, 217, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 438, 217, 48, 16
END

IDD_HOME_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Home Assistant webhook"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Webhook URL", -1, 10, 34, 58, 10
    EDITTEXT IDC_ACTION_URL, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "JSON payload", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PAYLOAD, 72, 56, 278, 62, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Delay (ms)", -1, 10, 130, 58, 10
    EDITTEXT IDC_ACTION_DELAY, 72, 128, 80, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END
