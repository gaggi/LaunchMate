#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "launchmate.ico"

IDD_PROGRAM_OPTIONS DIALOGEX 0, 0, 230, 104
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Program options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Arguments", -1, 10, 10, 70, 10
    EDITTEXT IDC_PROGRAM_ARGS, 10, 22, 210, 14, ES_AUTOHSCROLL
    LTEXT "Start delay (ms)", -1, 10, 44, 95, 10
    EDITTEXT IDC_PROGRAM_DELAY, 10, 56, 100, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Stop delay (ms)", -1, 120, 44, 95, 10
    EDITTEXT IDC_PROGRAM_CLOSE_DELAY, 120, 56, 100, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON "OK", IDC_PROGRAM_OK, 134, 82, 40, 14
    PUSHBUTTON "Cancel", IDC_PROGRAM_CANCEL, 178, 82, 42, 14
END

IDD_MONITOR_POWER_SETUPS DIALOGEX 0, 0, 520, 250
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Monitor configs"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Setups", -1, 10, 10, 80, 10
    LISTBOX IDC_MONITOR_SETUP_LIST, 10, 22, 126, 180, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON "+", IDC_MONITOR_SETUP_ADD, 10, 210, 28, 14
    PUSHBUTTON "-", IDC_MONITOR_SETUP_REMOVE, 42, 210, 28, 14
    LTEXT "Name", -1, 150, 10, 80, 10
    EDITTEXT IDC_MONITOR_SETUP_NAME, 150, 22, 175, 14, ES_AUTOHSCROLL
    LTEXT "Hotkey", -1, 335, 10, 80, 10
    CONTROL "", IDC_MONITOR_SETUP_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 335, 22, 175, 14
    PUSHBUTTON "Detect Current", IDC_MONITOR_SETUP_CAPTURE, 150, 210, 62, 14
    PUSHBUTTON "Apply", IDC_MONITOR_SETUP_APPLY, 382, 210, 36, 14
    DEFPUSHBUTTON "Save", IDC_MONITOR_SETUP_SAVE, 422, 210, 36, 14
    PUSHBUTTON "Close", IDC_MONITOR_SETUP_CLOSE, 462, 210, 40, 14
END

IDD_RULE_ACTIONS DIALOGEX 0, 0, 620, 410
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rule actions"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_ACTION_TAB, "SysTabControl32", WS_TABSTOP | TCS_FIXEDWIDTH, 10, 10, 600, 366
    CONTROL "", IDC_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 18, 38, 584, 294
    PUSHBUTTON "Add", IDC_ACTION_ADD, 18, 340, 48, 16
    PUSHBUTTON "Edit", IDC_ACTION_EDIT, 70, 340, 48, 16
    PUSHBUTTON "Remove", IDC_ACTION_REMOVE, 122, 340, 54, 16
    GROUPBOX "When the watched process starts", IDC_ACTION_MONITOR_APPLY_GROUP, 18, 40, 584, 120
    LTEXT "Monitor configuration", IDC_ACTION_MONITOR_LABEL, 30, 62, 140, 10
    COMBOBOX IDC_ACTION_MONITOR_COMBO, 30, 78, 560, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Apply delay (ms)", IDC_ACTION_MONITOR_DELAY_LABEL, 30, 110, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_DELAY, 136, 108, 76, 14, ES_NUMBER
    LTEXT "Use a saved monitor configuration while this watched process runs.", IDC_ACTION_MONITOR_APPLY_HINT, 30, 138, 560, 10
    GROUPBOX "When the watched process exits", IDC_ACTION_MONITOR_RESTORE_GROUP, 18, 178, 584, 100
    CONTROL "Restore the previous display configuration", IDC_ACTION_MONITOR_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 202, 560, 14
    LTEXT "Restore delay (ms)", IDC_ACTION_MONITOR_RESTORE_DELAY_LABEL, 30, 232, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_RESTORE_DELAY, 136, 230, 76, 14, ES_NUMBER
    LTEXT "Return to the monitor arrangement that was active before the rule started.", IDC_ACTION_MONITOR_RESTORE_HINT, 30, 256, 560, 10
    LTEXT "", IDC_ACTION_IRACING_HINT, 28, 52, 560, 30
    DEFPUSHBUTTON "OK", IDOK, 510, 386, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 562, 386, 48, 16
END

IDD_IRACING_PERFORMANCE_PANE DIALOGEX 0, 0, 570, 385
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Process performance while this watched process runs", -1, 8, 5, 350, 10
    CONTROL "", IDC_PERF_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 19, 548, 134
    PUSHBUTTON "Add running process", IDC_PERF_ACTION_ADD, 8, 160, 102, 18
    PUSHBUTTON "Edit", IDC_PERF_ACTION_EDIT, 118, 160, 48, 18
    PUSHBUTTON "Remove", IDC_PERF_ACTION_REMOVE, 174, 160, 58, 18
    LTEXT "Power plan while this watched process runs", -1, 8, 194, 280, 10
    COMBOBOX IDC_IRACING_PLAN, 8, 210, 340, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_IRACING_REFRESH, 390, 210, 70, 16
    GROUPBOX "Specific settings", IDC_IRACING_INI_GROUP, 8, 250, 548, 94
    CONTROL "carPreloadAll", IDC_IRACING_CAR_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 268, 218, 14
    PUSHBUTTON "Add Defender exclusions...", IDC_IRACING_DEFENDER, 382, 268, 166, 16
    CONTROL "trackTexturePreload", IDC_IRACING_TRACK_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 288, 218, 14
    LTEXT "streamingTextureSize", IDC_IRACING_STREAMING_LABEL, 20, 310, 110, 10
    EDITTEXT IDC_IRACING_STREAMING_SIZE, 140, 308, 76, 14, ES_NUMBER
    PUSHBUTTON "Save to app.ini", IDC_IRACING_INI, 20, 326, 102, 14
    LTEXT "Close iRacing before saving. A backup is created.", IDC_IRACING_INI_HINT, 140, 328, 400, 10
END

IDD_PROCESS_PERFORMANCE_ACTION DIALOGEX 0, 0, 500, 245
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Process performance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Running process", -1, 10, 12, 84, 10
    COMBOBOX IDC_PERF_PROCESS, 102, 10, 385, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU priority", -1, 10, 40, 84, 10
    COMBOBOX IDC_PERF_CPU_PRIORITY, 102, 38, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "I/O priority", -1, 280, 40, 70, 10
    COMBOBOX IDC_PERF_IO_PRIORITY, 354, 38, 133, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Memory priority", -1, 10, 68, 84, 10
    COMBOBOX IDC_PERF_MEMORY_PRIORITY, 102, 66, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU affinity (select the logical CPUs this process may use)", -1, 10, 100, 400, 10
    DEFPUSHBUTTON "OK", IDOK, 386, 217, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 438, 217, 48, 16
END

IDD_MPO_SETTINGS DIALOGEX 0, 0, 450, 174
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "MPO settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Current values", IDC_MPO_VALUES_GROUP, 12, 8, 426, 64
    LTEXT "Dwm / OverlayTestMode", -1, 24, 28, 192, 12
    LTEXT "Checking...", IDC_MPO_DWM_STATUS, 226, 28, 196, 12
    LTEXT "GraphicsDrivers / DisableOverlays", -1, 24, 50, 192, 12
    LTEXT "Checking...", IDC_MPO_GRAPHICS_STATUS, 226, 50, 196, 12
    LTEXT "MPO uses display hardware to combine image layers. Disabling it may help with flickering or stuttering when overlays are active.", -1, 14, 78, 422, 24
    LTEXT "Any change requires a Windows restart.", -1, 14, 108, 422, 10
    LTEXT "", IDC_MPO_MESSAGE, 14, 122, 422, 12
    PUSHBUTTON "Disable MPO", IDC_MPO_DISABLE, 14, 140, 110, 22
    PUSHBUTTON "Windows Default", IDC_MPO_RESTORE, 132, 140, 120, 22
    PUSHBUTTON "Close", IDOK, 374, 140, 62, 22
END

IDD_IRACING_SERVICES_PANE DIALOGEX 0, 0, 570, 385
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Disable and stop", IDC_IRACING_DISABLE_GROUP, 8, 5, 548, 102
    LTEXT "Restore the original start type after the watched process exits.", -1, 20, 23, 520, 10
    CONTROL "Windows Update", IDC_IRACING_SERVICE_FIRST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 40, 520, 14
    CONTROL "Update Orchestrator", IDC_IRACING_SERVICE_FIRST + 1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 60, 520, 14
    CONTROL "Windows Search", IDC_IRACING_SERVICE_FIRST + 2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 80, 520, 14
    GROUPBOX "Stop only when running", IDC_IRACING_STOP_GROUP, 8, 118, 548, 173
    LTEXT "Restart only services that were running before the rule started.", -1, 20, 136, 520, 10
    CONTROL "Print Spooler", IDC_IRACING_SERVICE_FIRST + 3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 152, 520, 14
    CONTROL "Wi-Fi", IDC_IRACING_SERVICE_FIRST + 4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 171, 520, 14
    CONTROL "Bluetooth AVCTP", IDC_IRACING_SERVICE_FIRST + 5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 190, 520, 14
    CONTROL "Bluetooth Audio Gateway", IDC_IRACING_SERVICE_FIRST + 6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 209, 520, 14
    CONTROL "Bluetooth Support", IDC_IRACING_SERVICE_FIRST + 7, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 228, 520, 14
    CONTROL "Xbox Live Auth", IDC_IRACING_SERVICE_FIRST + 8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 247, 520, 14
    CONTROL "Backblaze", IDC_IRACING_SERVICE_FIRST + 9, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 266, 520, 14
    LTEXT "Windows asks for administrator approval only when these actions run.", -1, 8, 302, 548, 10
    PUSHBUTTON "Select all", IDC_IRACING_SERVICE_ALL, 8, 320, 70, 18
END

IDD_START_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start program"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PATH, 72, 32, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 32, 34, 14
    LTEXT "Arguments", -1, 10, 58, 55, 10
    EDITTEXT IDC_ACTION_ARGUMENTS, 72, 56, 278, 14, ES_AUTOHSCROLL
    LTEXT "Start delay (ms)", -1, 10, 82, 82, 10
    EDITTEXT IDC_ACTION_DELAY, 96, 80, 70, 14, ES_NUMBER
    CONTROL "Close when watched process exits", IDC_ACTION_CLOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 108, 190, 12
    LTEXT "Stop delay (ms)", -1, 202, 108, 78, 10
    EDITTEXT IDC_ACTION_CLOSE_DELAY, 282, 106, 68, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END

IDD_STOP_ACTION DIALOGEX 0, 0, 360, 188
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Stop process"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Process", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PROCESS, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program path", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PATH, 72, 56, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 56, 34, 14
    CONTROL "Try graceful close first", IDC_ACTION_GRACEFUL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 84, 150, 12
    LTEXT "Force after (ms)", -1, 180, 84, 82, 10
    EDITTEXT IDC_ACTION_FORCE_DELAY, 270, 82, 80, 14, ES_NUMBER
    CONTROL "Restart when watched process exits", IDC_ACTION_RESTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 110, 198, 12
    LTEXT "Restart delay (ms)", -1, 206, 110, 82, 10
    EDITTEXT IDC_ACTION_RESTART_DELAY, 290, 108, 60, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 162, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 162, 48, 16
END

IDD_HOME_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Home Assistant webhook"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Webhook URL", -1, 10, 34, 58, 10
    EDITTEXT IDC_ACTION_URL, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "JSON payload", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PAYLOAD, 72, 56, 278, 62, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Delay (ms)", -1, 10, 130, 58, 10
    EDITTEXT IDC_ACTION_DELAY, 72, 128, 80, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END
