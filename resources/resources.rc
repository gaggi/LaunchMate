#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "launchmate.ico"

IDD_MONITOR_POWER_SETUPS DIALOGEX 0, 0, 380, 212
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Configs", -1, 0, 0, 80, 10
    LISTBOX IDC_MONITOR_SETUP_LIST, 0, 12, 100, 150, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON "+", IDC_MONITOR_SETUP_ADD, 0, 168, 28, 14
    PUSHBUTTON "-", IDC_MONITOR_SETUP_REMOVE, 32, 168, 28, 14
    LTEXT "Name", -1, 112, 0, 80, 10
    EDITTEXT IDC_MONITOR_SETUP_NAME, 112, 12, 140, 14, ES_AUTOHSCROLL
    LTEXT "Hotkey", -1, 262, 0, 80, 10
    CONTROL "", IDC_MONITOR_SETUP_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 262, 12, 118, 14
    PUSHBUTTON "Detect current", IDC_MONITOR_SETUP_CAPTURE, 112, 168, 70, 14
    PUSHBUTTON "Apply now", IDC_MONITOR_SETUP_APPLY, 188, 168, 60, 14
    LTEXT "", IDC_MONITOR_SETUP_STATUS, 112, 188, 268, 20
END

IDD_RULE_SECTION DIALOGEX 0, 0, 380, 260
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Add...", IDC_ACTION_ADD, 0, 0, 56, 16
    PUSHBUTTON "Edit...", IDC_ACTION_EDIT, 60, 0, 56, 16
    PUSHBUTTON "Remove", IDC_ACTION_REMOVE, 120, 0, 56, 16
    CONTROL "", IDC_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 22, 380, 238
    GROUPBOX "When the watched process starts", IDC_ACTION_MONITOR_APPLY_GROUP, 0, 0, 380, 92
    LTEXT "Monitor configuration", IDC_ACTION_MONITOR_LABEL, 10, 14, 140, 10
    COMBOBOX IDC_ACTION_MONITOR_COMBO, 10, 26, 360, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Apply delay (ms)", IDC_ACTION_MONITOR_DELAY_LABEL, 10, 48, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_DELAY, 116, 46, 70, 14, ES_NUMBER
    LTEXT "Use a saved monitor configuration while this watched process runs.", IDC_ACTION_MONITOR_APPLY_HINT, 10, 70, 360, 10
    GROUPBOX "When the watched process exits", IDC_ACTION_MONITOR_RESTORE_GROUP, 0, 100, 380, 82
    CONTROL "Restore the previous display configuration", IDC_ACTION_MONITOR_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 114, 360, 14
    LTEXT "Restore delay (ms)", IDC_ACTION_MONITOR_RESTORE_DELAY_LABEL, 10, 136, 100, 10
    EDITTEXT IDC_ACTION_MONITOR_RESTORE_DELAY, 116, 134, 70, 14, ES_NUMBER
    LTEXT "Return to the monitor arrangement that was active before the rule started.", IDC_ACTION_MONITOR_RESTORE_HINT, 10, 160, 360, 10
END

IDD_IRACING_PERFORMANCE_PANE DIALOGEX 0, 0, 380, 344
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Power plan while this watched process runs", -1, 0, 0, 290, 10
    COMBOBOX IDC_IRACING_PLAN, 0, 12, 296, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_IRACING_REFRESH, 302, 11, 70, 16
    LTEXT "Process priorities while this watched process runs", -1, 0, 38, 300, 10
    CONTROL "", IDC_PERF_ACTION_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 0, 50, 380, 90
    PUSHBUTTON "Add running process", IDC_PERF_ACTION_ADD, 0, 146, 102, 16
    PUSHBUTTON "Edit", IDC_PERF_ACTION_EDIT, 108, 146, 48, 16
    PUSHBUTTON "Remove", IDC_PERF_ACTION_REMOVE, 162, 146, 58, 16
    LTEXT "System check", -1, 0, 172, 200, 10
    EDITTEXT IDC_IRACING_STATUS, 0, 184, 380, 62, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    GROUPBOX "Specific settings", IDC_IRACING_INI_GROUP, 0, 254, 380, 90
    CONTROL "carPreloadAll", IDC_IRACING_CAR_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 270, 180, 14
    PUSHBUTTON "Add Defender exclusions...", IDC_IRACING_DEFENDER, 214, 269, 156, 16
    CONTROL "trackTexturePreload", IDC_IRACING_TRACK_PRELOAD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 288, 180, 14
    LTEXT "streamingTextureSize", IDC_IRACING_STREAMING_LABEL, 10, 310, 100, 10
    EDITTEXT IDC_IRACING_STREAMING_SIZE, 116, 308, 60, 14, ES_NUMBER
    PUSHBUTTON "Save to app.ini", IDC_IRACING_INI, 10, 326, 90, 14
    LTEXT "Close iRacing before saving. A backup is created.", IDC_IRACING_INI_HINT, 106, 328, 264, 10
END

IDD_PROCESS_PERFORMANCE_ACTION DIALOGEX 0, 0, 500, 245
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Process performance"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Running process", -1, 10, 12, 84, 10
    COMBOBOX IDC_PERF_PROCESS, 102, 10, 385, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU priority", -1, 10, 40, 84, 10
    COMBOBOX IDC_PERF_CPU_PRIORITY, 102, 38, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "I/O priority", -1, 280, 40, 70, 10
    COMBOBOX IDC_PERF_IO_PRIORITY, 354, 38, 133, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Memory priority", -1, 10, 68, 84, 10
    COMBOBOX IDC_PERF_MEMORY_PRIORITY, 102, 66, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "CPU affinity (select the logical CPUs this process may use)", -1, 10, 100, 400, 10
    DEFPUSHBUTTON "OK", IDOK, 386, 217, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 438, 217, 48, 16
END

IDD_SETTINGS DIALOGEX 0, 0, 380, 320
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Window behavior", -1, 0, 0, 380, 58
    CONTROL "Minimize to tray", IDC_SETTINGS_MINIMIZE_TO_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 14, 360, 12
    CONTROL "Close to tray", IDC_SETTINGS_CLOSE_TO_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 28, 360, 12
    CONTROL "Start in tray", IDC_SETTINGS_START_IN_TRAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 42, 360, 12
    GROUPBOX "Startup and updates", -1, 0, 66, 380, 60
    CONTROL "Start with Windows", IDC_SETTINGS_START_WITH_WINDOWS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 80, 360, 12
    CONTROL "Start monitoring on launch", IDC_SETTINGS_START_MONITORING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 94, 360, 12
    CONTROL "Check for updates on startup", IDC_SETTINGS_CHECK_UPDATES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 108, 200, 12
    PUSHBUTTON "Check now", IDC_SETTINGS_CHECK_NOW, 290, 106, 80, 14
    GROUPBOX "Monitoring", -1, 0, 134, 380, 62
    CONTROL "Start as administrator", IDC_SETTINGS_START_AS_ADMIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 148, 360, 12
    CONTROL "Use ETW for instant process detection (needs administrator)", IDC_SETTINGS_USE_ETW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 162, 360, 12
    LTEXT "These take effect the next time monitoring or LaunchMate starts.", -1, 10, 178, 360, 10
    GROUPBOX "Multiplane overlay (MPO)", IDC_MPO_VALUES_GROUP, 0, 204, 380, 114
    LTEXT "Applies system-wide and needs a Windows restart. Disabling MPO may help with flickering or stuttering when overlays are active.", -1, 10, 218, 360, 20
    LTEXT "Dwm / OverlayTestMode", -1, 10, 244, 150, 10
    LTEXT "Checking...", IDC_MPO_DWM_STATUS, 170, 244, 200, 10
    LTEXT "GraphicsDrivers / DisableOverlays", -1, 10, 258, 150, 10
    LTEXT "Checking...", IDC_MPO_GRAPHICS_STATUS, 170, 258, 200, 10
    PUSHBUTTON "Disable MPO", IDC_MPO_DISABLE, 10, 276, 80, 16
    PUSHBUTTON "Windows default", IDC_MPO_RESTORE, 96, 276, 86, 16
    LTEXT "", IDC_MPO_MESSAGE, 10, 298, 360, 12
END

IDD_IRACING_SERVICES_PANE DIALOGEX 0, 0, 380, 300
STYLE WS_CHILD | DS_CONTROL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Disable and stop", IDC_IRACING_DISABLE_GROUP, 0, 0, 380, 92
    LTEXT "Restore the original start type after the watched process exits.", -1, 10, 14, 360, 10
    CONTROL "Windows Update", IDC_IRACING_SERVICE_FIRST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 30, 360, 14
    CONTROL "Update Orchestrator", IDC_IRACING_SERVICE_FIRST + 1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 48, 360, 14
    CONTROL "Windows Search", IDC_IRACING_SERVICE_FIRST + 2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 66, 360, 14
    GROUPBOX "Stop only when running", IDC_IRACING_STOP_GROUP, 0, 100, 380, 160
    LTEXT "Restart only services that were running before the rule started.", -1, 10, 114, 360, 10
    CONTROL "Print Spooler", IDC_IRACING_SERVICE_FIRST + 3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 130, 360, 14
    CONTROL "Wi-Fi", IDC_IRACING_SERVICE_FIRST + 4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 148, 360, 14
    CONTROL "Bluetooth AVCTP", IDC_IRACING_SERVICE_FIRST + 5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 166, 360, 14
    CONTROL "Bluetooth Audio Gateway", IDC_IRACING_SERVICE_FIRST + 6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 184, 360, 14
    CONTROL "Bluetooth Support", IDC_IRACING_SERVICE_FIRST + 7, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 202, 360, 14
    CONTROL "Xbox Live Auth", IDC_IRACING_SERVICE_FIRST + 8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 220, 360, 14
    CONTROL "Backblaze", IDC_IRACING_SERVICE_FIRST + 9, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 238, 360, 14
    LTEXT "Windows asks for administrator approval only when these actions run.", -1, 0, 268, 380, 10
    PUSHBUTTON "Select all", IDC_IRACING_SERVICE_ALL, 0, 282, 70, 16
END

IDD_START_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Start program"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PATH, 72, 32, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 32, 34, 14
    LTEXT "Arguments", -1, 10, 58, 55, 10
    EDITTEXT IDC_ACTION_ARGUMENTS, 72, 56, 278, 14, ES_AUTOHSCROLL
    LTEXT "Start delay (ms)", -1, 10, 82, 82, 10
    EDITTEXT IDC_ACTION_DELAY, 96, 80, 70, 14, ES_NUMBER
    CONTROL "Close when watched process exits", IDC_ACTION_CLOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 108, 190, 12
    LTEXT "Stop delay (ms)", -1, 202, 108, 78, 10
    EDITTEXT IDC_ACTION_CLOSE_DELAY, 282, 106, 68, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END

IDD_STOP_ACTION DIALOGEX 0, 0, 360, 188
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Stop process"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Process", -1, 10, 34, 55, 10
    EDITTEXT IDC_ACTION_PROCESS, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "Program path", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PATH, 72, 56, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_ACTION_BROWSE, 316, 56, 34, 14
    CONTROL "Try graceful close first", IDC_ACTION_GRACEFUL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 84, 150, 12
    LTEXT "Force after (ms)", -1, 180, 84, 82, 10
    EDITTEXT IDC_ACTION_FORCE_DELAY, 270, 82, 80, 14, ES_NUMBER
    CONTROL "Restart when watched process exits", IDC_ACTION_RESTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 110, 198, 12
    LTEXT "Restart delay (ms)", -1, 206, 110, 82, 10
    EDITTEXT IDC_ACTION_RESTART_DELAY, 290, 108, 60, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 162, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 162, 48, 16
END

IDD_HOME_ACTION DIALOGEX 0, 0, 360, 190
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Home Assistant webhook"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", -1, 10, 10, 55, 10
    EDITTEXT IDC_ACTION_NAME, 72, 8, 278, 14, ES_AUTOHSCROLL
    LTEXT "Webhook URL", -1, 10, 34, 58, 10
    EDITTEXT IDC_ACTION_URL, 72, 32, 278, 14, ES_AUTOHSCROLL
    LTEXT "JSON payload", -1, 10, 58, 58, 10
    EDITTEXT IDC_ACTION_PAYLOAD, 72, 56, 278, 62, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Delay (ms)", -1, 10, 130, 58, 10
    EDITTEXT IDC_ACTION_DELAY, 72, 128, 80, 14, ES_NUMBER
    DEFPUSHBUTTON "OK", IDOK, 250, 164, 48, 16
    PUSHBUTTON "Cancel", IDCANCEL, 302, 164, 48, 16
END
